// The alias-cycle diagnostic under `--json` produces a structured
// error payload with the caller-anchored `filePath`. This pins the
// output shape distinct from the text-mode form used elsewhere, in
// both offline and `--http` runs with the cURL backend poisoned

ENV SOURCEMETA_CORE_CURL_SO $CWD/does-not-exist.so

WRITE meta-x.json UNTIL EOF
{
  "$schema": "https://example.com/meta-y",
  "$id": "https://example.com/meta-x",
  "$vocabulary": {
    "https://json-schema.org/draft/2020-12/vocab/core": true,
    "https://json-schema.org/draft/2020-12/vocab/applicator": true,
    "https://json-schema.org/draft/2020-12/vocab/validation": true
  }
}
EOF

WRITE meta-y.json UNTIL EOF
{
  "$schema": "https://example.com/meta-x",
  "$id": "https://example.com/meta-y",
  "$vocabulary": {
    "https://json-schema.org/draft/2020-12/vocab/core": true,
    "https://json-schema.org/draft/2020-12/vocab/applicator": true,
    "https://json-schema.org/draft/2020-12/vocab/validation": true
  }
}
EOF

WRITE jsonschema.json UNTIL EOF
{
  "resolve": {
    "https://example.com/meta-x": "meta-x.json",
    "https://example.com/meta-y": "meta-y.json"
  }
}
EOF

WRITE schema.json UNTIL EOF
{
  "$schema": "https://example.com/meta-x",
  "$id": "https://example.com/leaf",
  "type": "string"
}
EOF

WRITE instance.json UNTIL EOF
"hello"
EOF

// Offline JSON output
RUN validate schema.json instance.json --json STDIN /dev/null IN . INTO result_0.txt EXPECTING 4

REPLACE $CWD WITH '[CWD]' IN result_0.txt

WRITE expected_0.txt UNTIL EOF
1> {
1>   "error": "Could not resolve the metaschema of the schema",
1>   "identifier": "https://example.com/meta-x",
1>   "filePath": "[CWD]/schema.json"
1> }
EOF

COMPARE result_0.txt AGAINST expected_0.txt

// Under --http with the cURL backend poisoned
RUN validate schema.json instance.json --http --json STDIN /dev/null IN . INTO result_1.txt EXPECTING 4

REPLACE $CWD WITH '[CWD]' IN result_1.txt

COMPARE result_1.txt AGAINST expected_0.txt
