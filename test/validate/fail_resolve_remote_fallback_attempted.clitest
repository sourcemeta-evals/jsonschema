// Importing local schemas never touches the network, so a meta-schema that
// no local input declares reports the usual resolution error. Remote
// resolution stays available for reference resolution once every local
// entry imported successfully, which the second run proves through the
// poisoned cURL backend failing deterministically.

ENV SOURCEMETA_CORE_CURL_SO $CWD/does-not-exist.so

WRITE schema.json UNTIL EOF
{
  "$schema": "https://json-schema.org/draft/2020-12/schema",
  "type": "string"
}
EOF

WRITE orphan.json UNTIL EOF
{
  "$schema": "https://example.com/genuinely-remote-meta",
  "$id": "https://example.com/orphan",
  "type": "string"
}
EOF

WRITE local-meta.json UNTIL EOF
{
  "$schema": "https://json-schema.org/draft/2020-12/schema",
  "$id": "https://example.com/local-meta",
  "$vocabulary": {
    "https://json-schema.org/draft/2020-12/vocab/core": true,
    "https://json-schema.org/draft/2020-12/vocab/applicator": true,
    "https://json-schema.org/draft/2020-12/vocab/validation": true
  }
}
EOF

WRITE uses-local.json UNTIL EOF
{
  "$schema": "https://example.com/local-meta",
  "$id": "https://example.com/uses-local",
  "type": "string"
}
EOF

WRITE remote-ref.json UNTIL EOF
{
  "$schema": "https://json-schema.org/draft/2020-12/schema",
  "$ref": "https://example.com/genuinely-remote-target"
}
EOF

WRITE instance.json UNTIL EOF
"hello"
EOF

// A meta-schema that no local input declares fails the import with the
// usual resolution error
RUN validate schema.json instance.json --http --resolve orphan.json --resolve local-meta.json STDIN /dev/null IN . INTO result_0.txt EXPECTING 4

REPLACE $CWD WITH '[CWD]' IN result_0.txt

WRITE expected_0.txt UNTIL EOF
2> error: Could not resolve the metaschema of the schema
2>   at identifier https://example.com/genuinely-remote-meta
2>   at file path [CWD]/orphan.json
2>
2> This is likely because you forgot to import such schema using `--resolve/-r`
EOF

COMPARE result_0.txt AGAINST expected_0.txt

// Remote resolution must remain available after every local entry
// imported successfully
RUN validate remote-ref.json instance.json --http --resolve uses-local.json --resolve local-meta.json STDIN /dev/null IN . INTO result_1.txt EXPECTING 3

REPLACE $CWD WITH '[CWD]' IN result_1.txt

WRITE expected_1.txt UNTIL EOF
2> error: Could not load the cURL library from the configured path
2>   with environment variable SOURCEMETA_CORE_CURL_SO
2>   with paths
2>   - [CWD]/does-not-exist.so
EOF

COMPARE result_1.txt AGAINST expected_1.txt
