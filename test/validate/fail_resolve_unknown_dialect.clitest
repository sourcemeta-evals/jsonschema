WRITE schema.json UNTIL EOF
{
  "$schema": "https://json-schema.org/draft/2020-12/schema",
  "type": "object"
}
EOF

WRITE resolve.json UNTIL EOF
{
  "$schema": "https://example.com/unknown-metaschema",
  "$id": "https://example.com/resolve",
  "type": "string"
}
EOF

WRITE instance.json UNTIL EOF
{ "foo": "bar" }
EOF

// Unknown meta-schemas now fall back to the latest official dialect
RUN validate schema.json instance.json --resolve resolve.json STDIN /dev/null IN . INTO result_0.txt EXPECTING 0

WRITE expected_0.txt UNTIL EOF
EOF

COMPARE result_0.txt AGAINST expected_0.txt

// Unknown meta-schemas now fall back to the latest official dialect
RUN validate schema.json instance.json --resolve resolve.json --json STDIN /dev/null IN . INTO result_1.txt EXPECTING 0

WRITE expected_1.txt UNTIL EOF
1> {
1>   "valid": true
1> }
EOF

COMPARE result_1.txt AGAINST expected_1.txt
