// A `jsonschema.json` `resolve` alias must be applied before the
// resolver checks whether the target is pending locally. Otherwise a
// dependent schema whose `$schema` names the alias URI bypasses the
// pending-local suppression, reaches for the network to fetch the
// alias, and stalls even though the aliased meta-schema is supplied
// through `--resolve`. Under `--http` with the cURL backend poisoned,
// both `--resolve` orders must validate a matching instance and
// reject a non-matching one, all without initializing the network

ENV SOURCEMETA_CORE_CURL_SO $CWD/does-not-exist.so

WRITE main.json UNTIL EOF
{
  "$schema": "https://json-schema.org/draft/2020-12/schema",
  "$ref": "https://example.com/leaf"
}
EOF

WRITE leaf.json UNTIL EOF
{
  "$schema": "https://example.com/alias-meta",
  "$id": "https://example.com/leaf",
  "type": "string"
}
EOF

WRITE meta.json UNTIL EOF
{
  "$schema": "https://json-schema.org/draft/2020-12/schema",
  "$id": "https://example.com/real-meta",
  "$vocabulary": {
    "https://json-schema.org/draft/2020-12/vocab/core": true,
    "https://json-schema.org/draft/2020-12/vocab/applicator": true,
    "https://json-schema.org/draft/2020-12/vocab/validation": true
  }
}
EOF

WRITE jsonschema.json UNTIL EOF
{
  "resolve": {
    "https://example.com/alias-meta": "https://example.com/real-meta"
  }
}
EOF

WRITE string.json UNTIL EOF
"hello"
EOF

WRITE number.json UNTIL EOF
42
EOF

// Order 1: leaf before its aliased meta-schema, string accepted
RUN validate main.json string.json --http --resolve leaf.json --resolve meta.json --verbose STDIN /dev/null IN . INTO result_0.txt EXPECTING 0

REPLACE $CWD WITH '[CWD]' IN result_0.txt

WRITE expected_0.txt UNTIL EOF
2> Using extension: .json
2> Using extension: .yaml
2> Using extension: .yml
2> ok: [CWD]/string.json
2>   matches [CWD]/main.json
EOF

COMPARE result_0.txt AGAINST expected_0.txt

// Order 1: integer rejected by the meta-schema's contract
RUN validate main.json number.json --http --resolve leaf.json --resolve meta.json STDIN /dev/null IN . INTO result_1.txt EXPECTING 2

REPLACE $CWD WITH '[CWD]' IN result_1.txt

WRITE expected_1.txt UNTIL EOF
2> fail: [CWD]/number.json
2> error: Schema validation failure
2>   The value was expected to be of type string but it was of type integer
2>     at instance location "" (line 1, column 1)
2>     at evaluate path "/$ref/type"
2>   The integer value was expected to validate against the referenced schema
2>     at instance location "" (line 1, column 1)
2>     at evaluate path "/$ref"
EOF

COMPARE result_1.txt AGAINST expected_1.txt

// Order 2: meta-schema before leaf, string accepted
RUN validate main.json string.json --http --resolve meta.json --resolve leaf.json --verbose STDIN /dev/null IN . INTO result_2.txt EXPECTING 0

REPLACE $CWD WITH '[CWD]' IN result_2.txt

WRITE expected_2.txt UNTIL EOF
2> Using extension: .json
2> Using extension: .yaml
2> Using extension: .yml
2> ok: [CWD]/string.json
2>   matches [CWD]/main.json
EOF

COMPARE result_2.txt AGAINST expected_2.txt

// Order 2: integer rejected
RUN validate main.json number.json --http --resolve meta.json --resolve leaf.json STDIN /dev/null IN . INTO result_3.txt EXPECTING 2

REPLACE $CWD WITH '[CWD]' IN result_3.txt

WRITE expected_3.txt UNTIL EOF
2> fail: [CWD]/number.json
2> error: Schema validation failure
2>   The value was expected to be of type string but it was of type integer
2>     at instance location "" (line 1, column 1)
2>     at evaluate path "/$ref/type"
2>   The integer value was expected to validate against the referenced schema
2>     at instance location "" (line 1, column 1)
2>     at evaluate path "/$ref"
EOF

COMPARE result_3.txt AGAINST expected_3.txt
