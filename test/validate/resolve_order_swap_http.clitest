WRITE schema.json UNTIL EOF
{
  "$schema": "https://json-schema.org/draft/2020-12/schema",
  "$ref": "https://example.com/my-schema"
}
EOF

WRITE my-schema.json UNTIL EOF
{
  "$schema": "https://example.com/my-meta",
  "$id": "https://example.com/my-schema",
  "type": "string"
}
EOF

WRITE my-meta.json UNTIL EOF
{
  "$schema": "https://json-schema.org/draft/2020-12/schema",
  "$id": "https://example.com/my-meta",
  "$vocabulary": {
    "https://json-schema.org/draft/2020-12/vocab/core": true,
    "https://json-schema.org/draft/2020-12/vocab/applicator": true,
    "https://json-schema.org/draft/2020-12/vocab/validation": true
  }
}
EOF

WRITE instance.json UNTIL EOF
"hello"
EOF

RUN validate schema.json instance.json --http --resolve my-schema.json --resolve my-meta.json STDIN /dev/null IN . INTO result_0.txt EXPECTING 0

WRITE expected_0.txt UNTIL EOF
EOF

COMPARE result_0.txt AGAINST expected_0.txt
